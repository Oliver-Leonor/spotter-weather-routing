# ---- Backend (Django) ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Routing provider: valhalla (default, no key). Contact email is sent in the User-Agent per FOSSGIS terms.
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
VALHALLA_COSTING=auto
APP_CONTACT_EMAIL=you@example.com
# Weather provider: open-meteo (no key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
# Allow the clearly labeled fixture/demo mode (never presented as live weather)
ALLOW_FIXTURE_MODE=true
# Optional per-client rate limits (defaults shown). Each analysis calls the public providers.
# ANALYZE_THROTTLE_RATE=20/min
# GEOCODE_THROTTLE_RATE=120/min

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
